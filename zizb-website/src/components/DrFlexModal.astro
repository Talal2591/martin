---
/**
 * DrFlex-Terminbuchung — PLATZHALTER.
 *
 * Sobald der echte DrFlex-Einbettungscode vorliegt (wie auf zak10.de,
 * dort wird das Overlay per toggleDrFlexAppointments() ausgelöst):
 *   1. Das DrFlex-Skript hier bzw. im <head> von BaseLayout.astro einfügen.
 *   2. Der Klick-Handler unten ruft dann automatisch
 *      window.toggleDrFlexAppointments() auf — der Platzhalter-Dialog
 *      erscheint nur, solange DrFlex noch nicht eingebunden ist.
 *
 * Alle "Termin buchen"-Buttons der Website tragen das Attribut [data-termin].
 */
import { SITE } from '../data/site';
---

<dialog
  id="termin-modal"
  class="m-auto w-[min(92vw,32rem)] border border-gold/50 bg-creme-surface p-0 text-ink shadow-2xl backdrop:bg-navy/50"
  aria-labelledby="termin-modal-titel"
>
  <div class="p-8 sm:p-10">
    <p class="kicker">Terminbuchung</p>
    <h2 id="termin-modal-titel" class="mt-3 text-3xl">Termin vereinbaren</h2>
    <p class="mt-4 text-ink/80">
      Die Online-Terminbuchung (DrFlex) wird an dieser Stelle eingebunden.
      Bis dahin erreichen Sie uns jederzeit telefonisch oder per E-Mail —
      wir finden gemeinsam einen Termin, der zu Ihnen passt.
    </p>
    <div class="mt-7 grid gap-3">
      <a href={SITE.phoneHref} class="btn-primary w-full">Anrufen: {SITE.phone}</a>
      <a href={`mailto:${SITE.email}?subject=Terminanfrage`} class="btn-secondary w-full">E-Mail schreiben</a>
    </div>
    <button
      type="button"
      class="mt-6 text-sm text-ink/60 underline underline-offset-4 hover:text-navy"
      data-termin-close
    >
      Fenster schließen
    </button>
  </div>
</dialog>

<script>
  declare global {
    interface Window {
      toggleDrFlexAppointments?: () => void;
    }
  }
  const modal = document.getElementById('termin-modal') as HTMLDialogElement | null;
  document.querySelectorAll('[data-termin]').forEach((btn) => {
    btn.addEventListener('click', () => {
      // Sobald DrFlex eingebunden ist, übernimmt dessen Overlay.
      if (typeof window.toggleDrFlexAppointments === 'function') {
        window.toggleDrFlexAppointments();
      } else {
        modal?.showModal();
      }
    });
  });
  modal?.querySelector('[data-termin-close]')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>
