---
import { NAV, SITE } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-gold/40 bg-creme-surface/95 backdrop-blur-sm">
  <!-- Service-Zeile -->
  <div class="hidden bg-navy text-[0.82rem] text-white/90 md:block">
    <div class="site-container flex items-center justify-between py-1.5">
      <p class="m-0">{SITE.street} · {SITE.zip} {SITE.city} · barrierefrei erreichbar</p>
      <a href={SITE.phoneHref} class="font-medium tracking-wide hover:text-accent-soft">
        Telefon {SITE.phone}
      </a>
    </div>
  </div>

  <div class="site-container flex items-center justify-between gap-3 py-4 sm:gap-6">
    <!-- Logo / Wortmarke -->
    <a href="/" class="group flex min-w-0 shrink items-center gap-2.5 sm:gap-3" aria-label={`${SITE.name} – zur Startseite`}>
      <span class="grid size-10 shrink-0 place-items-center rounded-full border border-gold bg-creme-bg font-display text-xl text-navy sm:size-11" aria-hidden="true">Z</span>
      <span class="min-w-0 leading-tight">
        <span class="block truncate font-display text-[1.1rem] font-semibold text-navy sm:text-[1.35rem]">{SITE.shortName}</span>
        <span class="block text-[0.62rem] font-medium uppercase tracking-[0.26em] text-gold sm:text-[0.72rem]">{SITE.place}</span>
      </span>
    </a>

    <!-- Desktop-Navigation -->
    <nav class="hidden xl:block" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) =>
            item.children ? (
              <li class="group relative" data-nav-dropdown>
                <button
                  type="button"
                  class="flex items-center gap-1 px-2.5 py-2 text-[0.9rem] font-medium text-ink transition-colors hover:text-accent"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  {item.short ?? item.label}
                  <svg class="dropdown-chevron size-3 text-gold transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                </button>
                <ul class="dropdown-panel invisible absolute left-1/2 top-full z-50 w-72 -translate-x-1/2 border border-gold/40 bg-creme-surface py-2 opacity-0 shadow-lg shadow-navy/5 transition-all duration-150 group-focus-within:visible group-focus-within:opacity-100">
                  <li class="px-5 pb-1 pt-2 text-[0.7rem] font-medium uppercase tracking-[0.24em] text-gold" aria-hidden="true">{item.label}</li>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="block px-5 py-2 text-[0.92rem] text-ink hover:bg-creme-bg hover:text-accent">
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="block px-2.5 py-2 text-[0.9rem] font-medium text-ink transition-colors hover:text-accent">
                  {item.short ?? item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <button type="button" class="btn-primary hidden px-5 py-2.5 text-[0.88rem] lg:inline-flex" data-termin>
        Termin buchen
      </button>
      <!-- Mobile: Menü-Button -->
      <button
        type="button"
        id="mobile-menu-button"
        class="inline-flex shrink-0 items-center gap-2 border border-navy px-3 py-2.5 text-[0.88rem] font-medium text-navy sm:px-4 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menü öffnen"
      >
        <span class="hidden sm:inline">Menü</span>
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 3.5h14M1 8h14M1 12.5h14" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile-Navigation -->
  <div id="mobile-menu" class="hidden border-t border-gold/40 bg-creme-surface xl:hidden">
    <nav class="site-container max-h-[75vh] overflow-y-auto py-4" aria-label="Hauptnavigation mobil">
      <ul class="divide-y divide-gold/30">
        {
          NAV.map((item) =>
            item.children ? (
              <li>
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 font-medium text-navy [&::-webkit-details-marker]:hidden">
                    {item.label}
                    <svg class="size-3.5 text-gold transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  </summary>
                  <ul class="pb-3 pl-4">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="block py-2 text-[0.95rem] text-ink hover:text-accent">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} class="block py-3.5 font-medium text-navy hover:text-accent">
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="mt-5 grid gap-3">
        <button type="button" class="btn-primary w-full" data-termin>Termin buchen</button>
        <a href={SITE.phoneHref} class="btn-secondary w-full">Telefon {SITE.phone}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Geöffneter Zustand der Desktop-Dropdowns (per JS gesetztes data-open) */
  [data-nav-dropdown][data-open] .dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
  [data-nav-dropdown][data-open] .dropdown-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // Mobile-Menü
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
  });

  // Desktop-Dropdowns: Klick öffnet/schließt, Escape & Außenklick schließen.
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');
  const closeAll = (except?: HTMLElement) => {
    dropdowns.forEach((d) => {
      if (d !== except) {
        delete d.dataset.open;
        d.querySelector('button')?.setAttribute('aria-expanded', 'false');
      }
    });
  };
  dropdowns.forEach((dropdown) => {
    const button = dropdown.querySelector('button');
    button?.addEventListener('click', () => {
      const willOpen = !('open' in dropdown.dataset);
      closeAll(dropdown);
      if (willOpen) dropdown.dataset.open = '';
      else delete dropdown.dataset.open;
      button.setAttribute('aria-expanded', String(willOpen));
    });
    // Hover öffnet auf Geräten mit Maus
    if (window.matchMedia('(hover: hover)').matches) {
      dropdown.addEventListener('mouseenter', () => {
        closeAll(dropdown);
        dropdown.dataset.open = '';
        dropdown.querySelector('button')?.setAttribute('aria-expanded', 'true');
      });
      dropdown.addEventListener('mouseleave', () => {
        delete dropdown.dataset.open;
        dropdown.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-nav-dropdown]')) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
